# ---------------------------------------------------------------------------
# RESTORIO — environment template. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Provider: auto | anthropic | kimi | openai | ollama | offline
#   auto    picks the first provider that has a key, else falls back to offline
#   offline runs the deterministic reasoner — no key, no network, no cost
RESTORIO_PROVIDER=kimi

# --- Kimi / Moonshot (OpenAI-compatible, native tool calling) --------------
KIMI_API_KEY=
# Endpoint. Accounts made on platform.moonshot.ai use the .ai host (default).
# Accounts made on the mainland console (platform.moonshot.cn) need .cn —
# switch this if a valid-looking key returns 401.
# RESTORIO_KIMI_BASE_URL=https://api.moonshot.ai/v1
# RESTORIO_KIMI_BASE_URL=https://api.moonshot.cn/v1
# Model. kimi-k2-0711-preview is the strongest for multi-step tool use.
# Alternatives: kimi-k2-turbo-preview (faster), moonshot-v1-128k, kimi-latest
# RESTORIO_KIMI_MODEL=kimi-k2-0711-preview

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=
RESTORIO_MODEL=claude-opus-5

# --- OpenAI, or any other OpenAI-compatible endpoint ----------------------
OPENAI_API_KEY=
# RESTORIO_OPENAI_MODEL=gpt-4o
# RESTORIO_OPENAI_BASE_URL=https://api.openai.com/v1   # DeepSeek, Groq, vLLM...

# --- Local -----------------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# RESTORIO_OLLAMA_MODEL=llama3.1

# --- Agent behaviour -------------------------------------------------------
# supervised (approve everything) | guarded (approve high risk) | full
RESTORIO_AUTONOMY=guarded

# If the provider fails mid-incident, continue with the deterministic reasoner
# instead of escalating. Default false (the honest behaviour the tests check).
# Set true only as a live-demo safety net.
RESTORIO_FALLBACK_OFFLINE=false

# A slower model may need a longer budget per incident.
RESTORIO_LLM_TIMEOUT=120
RESTORIO_INCIDENT_BUDGET=300

# --- Server / simulation ---------------------------------------------------
RESTORIO_HOST=127.0.0.1
RESTORIO_PORT=8080
RESTORIO_SPEED=1.0
RESTORIO_SEED=20261030
